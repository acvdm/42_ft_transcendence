{
	"compilerOptions": {
		"target": "ES2022",
    	"module": "NodeNext",
    	"moduleResolution": "NodeNext",
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true, 

		"baseUrl": ".",
		"paths": {
			"*":["conf/node_modules/*"]
		},

		"typeRoots": [
			"./conf/node_modules/@types",
			"./node_modules/@types"
		]
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules"]
}