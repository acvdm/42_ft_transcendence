{
	"compilerOptions": {
		"target": "ES2022",
		"module": "commonjs",
		"outDir": "./dist",
		"rootDir": "./scripts",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["node"]
	},
	"include": ["scripts/**/*"],
	"exclude": ["node_modules", "conf"]
}
